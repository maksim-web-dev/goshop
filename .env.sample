# ──────────────────────────────────────────────
# product-service  (port 8080)
# ──────────────────────────────────────────────
PRODUCT_SERVER_PORT=8080
PRODUCT_API_PREFIX=/api

PRODUCT_POSTGRES_HOST=localhost
PRODUCT_POSTGRES_PORT=5432
PRODUCT_POSTGRES_DB=product_db
PRODUCT_POSTGRES_USER=postgres
PRODUCT_POSTGRES_PASSWORD=postgres

PRODUCT_HIKARI_POOL_MAX=25
PRODUCT_HIKARI_POOL_MIN=2
PRODUCT_HIKARI_POOL_TIMEOUT_MILLIS=30000
PRODUCT_POSTGRES_SHOW_SQL=true
PRODUCT_POSTGRES_DDL_AUTO=update

PRODUCT_SEED_ENABLE=true
PRODUCT_SEED_MODE=init
PRODUCT_SEED_STOP_COUNT=1

