RECOMMENDATIONS_API_PREFIX=/api

RECOMMENDATIONS_POSTGRES_HOST=localhost
RECOMMENDATIONS_POSTGRES_PORT=5432
RECOMMENDATIONS_POSTGRES_DB=recommendations_db
RECOMMENDATIONS_POSTGRES_USER=postgres
RECOMMENDATIONS_POSTGRES_PASSWORD=postgres

RECOMMENDATIONS_HIKARI_POOL_MAX=25
RECOMMENDATIONS_HIKARI_POOL_MIN=2
RECOMMENDATIONS_HIKARI_POOL_TIMEOUT_MILLIS=30000
RECOMMENDATIONS_POSTGRES_SHOW_SQL=true
RECOMMENDATIONS_POSTGRES_DDL_AUTO=update

RECOMMENDATIONS_SEED_ENABLE=false
RECOMMENDATIONS_SEED_MODE=init
RECOMMENDATIONS_SEED_STOP_COUNT=1
