COMPATIBILITY_API_PREFIX=/api

COMPATIBILITY_POSTGRES_HOST=localhost
COMPATIBILITY_POSTGRES_PORT=5432
COMPATIBILITY_POSTGRES_DB=compatibility_db
COMPATIBILITY_POSTGRES_USER=postgres
COMPATIBILITY_POSTGRES_PASSWORD=postgres

COMPATIBILITY_HIKARI_POOL_MAX=25
COMPATIBILITY_HIKARI_POOL_MIN=2
COMPATIBILITY_HIKARI_POOL_TIMEOUT_MILLIS=30000
COMPATIBILITY_POSTGRES_SHOW_SQL=true
COMPATIBILITY_POSTGRES_DDL_AUTO=update

COMPATIBILITY_SEED_ENABLE=false
COMPATIBILITY_SEED_MODE=init
COMPATIBILITY_SEED_STOP_COUNT=1
