STORE_SERVER_PORT=8087
STORE_API_PREFIX=/api

STORE_POSTGRES_HOST=localhost
STORE_POSTGRES_PORT=5432
STORE_POSTGRES_DB=store_db
STORE_POSTGRES_USER=postgres
