LOCALIZATION_API_PREFIX=/api

LOCALIZATION_POSTGRES_HOST=localhost
LOCALIZATION_POSTGRES_PORT=5432
LOCALIZATION_POSTGRES_DB=localization_db
LOCALIZATION_POSTGRES_USER=postgres
LOCALIZATION_POSTGRES_PASSWORD=postgres

LOCALIZATION_HIKARI_POOL_MAX=25
LOCALIZATION_HIKARI_POOL_MIN=2
LOCALIZATION_HIKARI_POOL_TIMEOUT_MILLIS=30000
LOCALIZATION_POSTGRES_SHOW_SQL=true
LOCALIZATION_POSTGRES_DDL_AUTO=update

LOCALIZATION_SEED_ENABLE=false
LOCALIZATION_SEED_MODE=init
LOCALIZATION_SEED_STOP_COUNT=1
