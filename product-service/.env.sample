PRODUCT_HIKARI_POOL_TIMEOUT_MILLIS=30000
PRODUCT_POSTGRES_SHOW_SQL=true
PRODUCT_POSTGRES_DDL_AUTO=update

PRODUCT_SEED_ENABLE=false
PRODUCT_SEED_MODE=init
PRODUCT_SEED_STOP_COUNT=1