PRODUCT_API_PREFIX=/api

PRODUCT_POSTGRES_HOST=localhost
PRODUCT_POSTGRES_PORT=5432
PRODUCT_POSTGRES_DB=product_db
PRODUCT_POSTGRES_USER=postgres
PRODUCT_POSTGRES_PASSWORD=postgres

PRODUCT_HIKARI_POOL_MAX=25
